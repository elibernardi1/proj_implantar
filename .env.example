# =====================================================
# Configurações do Banco de Dados (MySQL / Sequelize)
# =====================================================
DB_NAME=nome_do_banco
DB_USER=usuario
DB_PASSWORD=senha
DB_HOST=localhost
DB_PORT=3306

# =====================================================
# Autenticação JWT
# =====================================================
JWT_SECRET=coloque_aqui_uma_chave_secreta_forte

# =====================================================
# Servidor Express
# =====================================================
PORT=3000

# =====================================================
# E-mail (Nodemailer) — formulário de contato e alertas
# =====================================================
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=contato@exemplo.com
SMTP_PASS=senha_ou_app_password
SMTP_FROM="Del Company <contato@exemplo.com>"
CONTATO_DESTINO=contato@exemplo.com
